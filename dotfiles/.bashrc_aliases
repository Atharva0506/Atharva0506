# ─── NAVIGATION ───────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -la'
alias cls='clear'

# ─── GIT ──────────────────────────────────────
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias gl='git pull'
alias glog='git log --oneline --graph --decorate'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gundo='git reset --soft HEAD~1'
alias gnuke='git reset --hard HEAD'

# ─── PNPM ─────────────────────────────────────
alias pi='pnpm install'
alias pa='pnpm add'
alias pad='pnpm add -D'
alias pr='pnpm run'
alias prs='pnpm run start'
alias prd='pnpm run dev'
alias prb='pnpm run build'
alias prt='pnpm run test'
alias prl='pnpm run lint'
alias prp='pnpm run preview'
alias nuke='rm -rf node_modules && pnpm install'
alias plogs='pnpm dev 2>&1 | tee dev.log'
alias pwls='pnpm -w ls'
alias pwi='pnpm -w install'
alias pfilter='pnpm --filter'

# ─── DOCKER ───────────────────────────────────
alias d='docker'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'
alias dlogs='docker logs -f'
alias dstop='docker stop $(docker ps -q)'
alias dclean='docker system prune -af'
alias drmimg='docker rmi $(docker images -q)'
alias dcu='docker-compose up -d'
alias dcd='docker-compose down'
alias dcl='docker-compose logs -f'
alias dcr='docker-compose restart'
alias dcb='docker-compose up -d --build'

# ─── KUBERNETES / KUBECTL ─────────────────────
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgpa='kubectl get pods -A'
alias kgs='kubectl get services'
alias kgd='kubectl get deployments'
alias kgn='kubectl get nodes'
alias kd='kubectl describe'
alias kdp='kubectl describe pod'
alias klogs='kubectl logs -f'
alias kex='kubectl exec -it'
alias kaf='kubectl apply -f'
alias kdf='kubectl delete -f'
alias kctx='kubectl config current-context'
alias kns='kubectl config set-context --current --namespace'
alias kwatch='watch kubectl get pods'

# ─── KIND ─────────────────────────────────────
alias kcc='kind create cluster'
alias kdc='kind delete cluster'
alias klc='kind get clusters'

# ─── MISC ─────────────────────────────────────
alias myip='curl ifconfig.me'
alias ports='netstat -tulanp'
alias reload='source ~/.bashrc'
alias bashrc='nano ~/.bashrc'

# ─── PYTHON / FASTAPI ─────────────────────────
alias venv='python3 -m venv .venv'
alias va='source .venv/bin/activate'
alias vd='deactivate'
alias serve='uvicorn main:app --reload'
alias pip='pip3'
alias pipi='pip3 install -r requirements.txt'
alias pipf='pip3 freeze > requirements.txt'
